{
  "name": "iamfabriceg-bot-discord",
  "version": "1.0.0",
  "description": "iamfabriceg Bot — bot Discord personnel",
  "main": "src/index.js",
  "author": "Fabrice Geib",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "deploy": "node src/tasks/deploy-commands.js",
    "send:roles": "node src/tasks/send-roles.js",
    "twitch:subscribe": "node src/tasks/subscribe-twitch.js",
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "node --test \"tests/*.test.js\"",
    "cms:dev": "pnpm --filter cms dev",
    "cms:build": "pnpm --filter cms build",
    "cms:start": "pnpm --filter cms start",
    "cms:seed": "pnpm --filter cms seed",
    "cms:types": "pnpm --filter cms generate:types",
    "cms:catalog": "node src/tasks/export-command-catalog.js",
    "cms:sync-commands": "node src/tasks/sync-cms-commands.js",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
