# ============================================================================
# iamfabriceg Bot — configuration complète (bot Discord + CMS + Docker)
# Copier vers `.env` : cp .env.example .env
# Ne JAMAIS committer le fichier `.env` réel.
# ============================================================================

# --- Discord (obligatoire) -------------------------------------------------
# Token du bot :Developer Portal > Application > Bot > Token
# Le token actuel est conservé : ne le rotationne pas pour l'instant.
DISCORD_TOKEN=
# Developer Portal > General Information > Application ID
CLIENT_ID=
# Discord > Paramètres > Avancé > Mode développeur > clic droit sur le serveur
GUILD_ID=

# --- Salons et rôles Discord (optionnels) ----------------------------------
# Salon de test libre (ID par défaut)
ROLES_CHANNEL_ID=652684137957818378
LOG_CHANNEL_ID=
ANNOUNCEMENT_CHANNEL_ID=
# Rôles déjà câblés : Fortnite 722561307903262831, GTA V 722565846383329282,
# Rocket League 802663319634575362. À créer puis renseigner :
ROLE_ANIIMO_ID=
ROLE_GOALS_ID=

# --- Journalisation et serveur HTTP du bot --------------------------------
LOG_LEVEL=info
# Port du serveur HTTP léger (healthcheck + webhooks)
PORT=3000
# Secret partagé bot <-> CMS / Twitch pour les webhooks (x-webhook-secret)
WEBHOOK_SECRET=
# URL HTTPS publique du bot (callback Twitch EventSub, derrière un tunnel)
PUBLIC_URL=https://bot.exemple.com

# --- APIs externes (optionnelles, dégradation gracieuse) -------------------
# PokéAPI, Fortnite shop/news, FreeToGame, GamerPower, CheapShark,
# Speedrun.com et Open Trivia ne nécessitent aucune clé.
# dash.fortnite-api.com > API key (stats joueurs)
FORTNITE_API_KEY=
# rawg.io/apidocs > sign up > API key (20 000 req/mois)
RAWG_API_KEY=
# developer.riotgames.com > dev key 24 h (prod à faire valider)
RIOT_API_KEY=
# steamcommunity.com/dev/apikey (domaine : localhost)
STEAM_API_KEY=
# dev.twitch.tv/console/apps > New Secret + OAuth Redirect http://localhost
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Payload CMS v3 (local ou Docker) -------------------------------------
# Local      : mongodb://127.0.0.1:27017/iamfabriceg_bot
# Docker     : mongodb://mongo:27017/iamfabriceg_bot
DATABASE_URI=mongodb://127.0.0.1:27017/iamfabriceg_bot
# Chaîne aléatoire : openssl rand -hex 32
PAYLOAD_SECRET=
# Local : http://127.0.0.1:3001 | Docker : http://cms:3001
PAYLOAD_URL=http://127.0.0.1:3001
# Port d'écoute du CMS dans le conteneur et en local
CMS_PORT=3001
# Généré par `pnpm cms:seed` (affiché en console)
PAYLOAD_API_KEY=
PAYLOAD_AUTH_SLUG=users
PAYLOAD_GAMES_SLUG=games
# URL du bot que le CMS appelle pour ses webhooks
# Local : http://127.0.0.1:3000 | Docker : http://bot:3000
BOT_WEBHOOK_URL=http://127.0.0.1:3000
# Mot de passe admin créé par le seed (à changer après premier login)
SEED_ADMIN_PASSWORD=Admin1234!

# --- Docker ----------------------------------------------------------------
# Les variables ci-dessus sont lues par les deux compose files.
# En Docker, PAYLOAD_URL/BOT_WEBHOOK_URL/DATABASE_URI sont surchargés
# automatiquement par les services `cms` et `bot`.
COMPOSE_PROJECT_NAME=iamfabriceg-bot
