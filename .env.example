# Discord (obligatoire) — ne jamais committer le fichier .env réel
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Journalisation et serveur HTTP local (healthcheck + webhooks)
LOG_LEVEL=info
PORT=3000
WEBHOOK_SECRET=
PUBLIC_URL=https://bot.exemple.com

# APIs externes (optionnelles : le bot dégrade gracieusement si absentes)
FORTNITE_API_KEY=
RAWG_API_KEY=
RIOT_API_KEY=
STEAM_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Payload CMS v3 (optionnel)
PAYLOAD_URL=
PAYLOAD_AUTH_SLUG=users
PAYLOAD_GAMES_SLUG=games
PAYLOAD_API_KEY=

# Salons et rôles Discord (optionnels)
ROLES_CHANNEL_ID=652684137957818378
LOG_CHANNEL_ID=
ANNOUNCEMENT_CHANNEL_ID=
ROLE_ANIIMO_ID=
ROLE_GOALS_ID=
