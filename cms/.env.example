# MongoDB (Payload stocke aussi les users et les tokens ici)
DATABASE_URI=mongodb://127.0.0.1:31017/iamfabriceg_bot

# Secret de chiffrement Payload (API keys) — à remplacer en production
PAYLOAD_SECRET=change-me-with-a-long-random-string

# URL interne service-à-service (le bot appelle cette URL ; 3001 dans le conteneur)
PAYLOAD_URL=http://localhost:31001
# Origine navigateur, ajoutée à csrf/cors (obligatoire pour les POST de l'admin)
PAYLOAD_PUBLIC_URL=http://localhost:31001
PORT=31001
PUBLIC_URL=http://localhost:31001

# Webhooks Payload -> bot
WEBHOOK_SECRET=change-me-shared-with-the-bot
BOT_WEBHOOK_URL=http://localhost:31000

# Seed (optionnel)
SEED_ADMIN_PASSWORD=Admin1234!
