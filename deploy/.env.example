# ============================================================================
# VPS — modèle pour `deploy/.env`
# Copier ce fichier vers `.env` puis remplir les valeurs (ne jamais committer).
# AVANT de copier vers le VPS : remplacer MONGO_USER et MONGO_PASSWORD ci-dessous
# par des identifiants ENCODÉS dans l'URL. Le .env fourni est déjà encodé.
# Ports hôtes : 31000 bot / 31001 CMS ; ports internes : 3000 / 3001.
# ============================================================================

# --- Discord (obligatoire) : mêmes valeurs que ta machine locale ------------
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
DISCORD_INVITE_URL=
DISCORD_INVITE_URL_GUILD=

# --- Salons et rôles Discord ------------------------------------------------
ROLES_CHANNEL_ID=652684137957818378
LOG_CHANNEL_ID=
ANNOUNCEMENT_CHANNEL_ID=
ROLE_ANIIMO_ID=
ROLE_GOALS_ID=

# --- Bot --------------------------------------------------------------------
LOG_LEVEL=info
# Port INTERNE du conteneur ; le port hôte est 31000 dans le Compose.
PORT=3000
USAGE_TELEMETRY_ENABLED=true
WEBHOOK_SECRET=
# Callback Twitch public : laisse vide, DEPLOY_URL ci-dessous est utilisé.
PUBLIC_URL=https://bot.iamfabriceg.xyz

# --- APIs externes (optionnelles) -------------------------------------------
FORTNITE_API_KEY=
RAWG_API_KEY=
# LAISSER VIDE EN PROD : une clé dev Riot expire en 24 h.
RIOT_API_KEY=
STEAM_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- MongoDB EXTERNE (déjà présente sur le VPS) ----------------------------
# Remplacer MONGO_USER / MONGO_PASSWORD par les identifiants existants.
# Hôte = `mongodb`, le nom du conteneur existant : il doit etre attache au reseau
# `nginx-proxy-manager` (voir deploy/README.md, section « Prérequis réseau »).
# Encoder le mot de passe dans l'URL : ! -> %21, @ -> %40, # -> %23, / -> %2F, : -> %3A.
DATABASE_URI=mongodb://MONGO_USER:MONGO_PASSWORD@mongodb:27017/iamfabriceg_bot?authSource=admin

# --- Payload CMS : valeurs internes au réseau Docker -----------------------
PAYLOAD_SECRET=
PAYLOAD_URL=http://iamfabriceg-bot-cms:3001
# Port INTERNE du CMS ; le port hôte est 31001 dans le Compose.
CMS_PORT=3001
# Clé API créée par le seed LOCAL et restaurée avec la base : ne pas régénérer.
PAYLOAD_API_KEY=
PAYLOAD_AUTH_SLUG=users
PAYLOAD_GAMES_SLUG=games
BOT_WEBHOOK_URL=http://iamfabriceg-bot:3000
# Inutile en prod (pas de seed dans ce Compose) ; conservé pour référence.
SEED_ADMIN_PASSWORD=

# --- Domaine public (une seule ligne à changer si tu changes de domaine) ----
DEPLOY_URL=https://bot.iamfabriceg.xyz
COMPOSE_PROJECT_NAME=iamfabriceg-bot
