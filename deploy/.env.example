# ============================================================================
# VPS — modèle pour `deploy/.env`
# Copier ce fichier vers `.env` puis remplir les valeurs (ne jamais committer).
# Sur le VPS, le fichier `.env` fourni est déjà prêt à l'emploi.
# ============================================================================

# --- Discord (obligatoire) : mêmes valeurs que ta machine locale ------------
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
DISCORD_INVITE_URL=
DISCORD_INVITE_URL_GUILD=

# --- Salons et rôles Discord ------------------------------------------------
ROLES_CHANNEL_ID=652684137957818378
LOG_CHANNEL_ID=
ANNOUNCEMENT_CHANNEL_ID=
ROLE_ANIIMO_ID=
ROLE_GOALS_ID=

# --- Bot --------------------------------------------------------------------
LOG_LEVEL=info
PORT=3000
USAGE_TELEMETRY_ENABLED=true
WEBHOOK_SECRET=
# Callback Twitch public : laisse vide, DEPLOY_URL ci-dessous est utilisé.
PUBLIC_URL=https://bot.iamfabriceg.xyz

# --- APIs externes (optionnelles) -------------------------------------------
FORTNITE_API_KEY=
RAWG_API_KEY=
# LAISSER VIDE EN PROD : une clé dev Riot expire en 24 h.
RIOT_API_KEY=
STEAM_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Payload CMS : valeurs internes au réseau Docker -----------------------
DATABASE_URI=mongodb://mongo:27017/iamfabriceg_bot
PAYLOAD_SECRET=
PAYLOAD_URL=http://cms:3001
CMS_PORT=3001
# Clé API créée par le seed LOCAL et restaurée avec la base : ne pas régénérer.
PAYLOAD_API_KEY=
PAYLOAD_AUTH_SLUG=users
PAYLOAD_GAMES_SLUG=games
BOT_WEBHOOK_URL=http://bot:3000
# Inutile en prod (pas de seed dans ce Compose) ; conservé pour référence.
SEED_ADMIN_PASSWORD=

# --- Domaine public (une seule ligne à changer si tu changes de domaine) ----
DEPLOY_URL=https://bot.iamfabriceg.xyz
COMPOSE_PROJECT_NAME=iamfabriceg-bot
